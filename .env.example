# Demo target (local only). These values are not secrets.
TARGET_HOST=127.0.0.1
TARGET_PORT=8000
TARGET_LATENCY_MS=0
TARGET_LATENCY_JITTER_MS=0
TARGET_ERROR_RATE=0
# Set to yes only when you intentionally expose the demo API beyond localhost.
TARGET_ALLOW_REMOTE_BIND=

# perfload runner. Leave the acknowledgement empty unless you own the target.
PERFLOAD_BASE_URL=http://127.0.0.1:8000
PERFLOAD_PROFILE=ramp
PERFLOAD_USERS=10
PERFLOAD_SPAWN_RATE=2
PERFLOAD_DURATION=40
PERFLOAD_USERNAME=demo
PERFLOAD_PASSWORD=demo-pass
PERFLOAD_OUTPUT_DIR=reports/latest
PERFLOAD_ACKNOWLEDGE_AUTHORIZATION=
